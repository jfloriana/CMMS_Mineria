# GEMINI_API_KEY: Required for Gemini AI API calls.
# En local: copiar este archivo a .env.local y poner tu key real.
# En Vercel: configurar en Dashboard > Settings > Environment Variables (no commitear el valor real).
# AI Studio inyecta automáticamente este secreto en runtime si usas AI Studio.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# APP_URL: The URL where this app is hosted.
# En Vercel se autoinyecta; en local usar http://localhost:3000
APP_URL="http://localhost:3000"
